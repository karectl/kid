{
  "name": "kid-k8tre-training",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [
    "k3s-server:80"
  ],
  "portsAttributes": {
    "k3s-server:80": {
      "label": "TRE ingress",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "CODESPACE_NAME": "${localEnv:CODESPACE_NAME}",
    "GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN": "${localEnv:GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}",
    "GITHUB_REPOSITORY": "${localEnv:GITHUB_REPOSITORY}",
    "TRE_HTTP_PORT": "${localEnv:TRE_HTTP_PORT}",
    "KID_ENABLE_KYVERNO": "${localEnv:KID_ENABLE_KYVERNO}",
    "KID_GITOPS_REPO": "${localEnv:KID_GITOPS_REPO}",
    "KID_GITOPS_REVISION": "${localEnv:KID_GITOPS_REVISION}",
    "KUBECONFIG": "/home/vscode/.kube/config"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "bierner.markdown-mermaid"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  },
  "postCreateCommand": "bash -c 'set -o pipefail; bash .devcontainer/bootstrap.sh 2>&1 | tee /tmp/kid-bootstrap.log'",
  "postAttachCommand": "scripts/tre info || true"
}
