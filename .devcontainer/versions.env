# Pinned versions for the KID training cluster.
# Sourced by bootstrap.sh. CLI versions live as ARGs in devcontainer.Dockerfile
# and the k3s image tag lives in docker-compose.yml; keep all three in step.
# See docs/reference/versions.md before upgrading anything.
export K3S_VERSION="v1.31.5-k3s1"
export CILIUM_VERSION="1.16.5"
# Hubble UI < v0.13.3 ignores hubble.ui.baseUrl in its router (404 under /hubble/).
export HUBBLE_UI_VERSION="v0.13.3"
export HUBBLE_UI_DIGEST="sha256:661d5de7050182d495c6497ff0b007a7a1e379648e60830dd68c4d78ae21761d"
export HUBBLE_UI_BACKEND_DIGEST="sha256:db1454e45dc39ca41fbf7cad31eec95d99e5b9949c39daaad0fa81ef29d56953"
export ARGOCD_VERSION="v3.0.0"
# The following are informational here; Argo CD reads them from gitops/.
export KYVERNO_CHART_VERSION="3.3.4"
export KEYCLOAK_IMAGE="quay.io/keycloak/keycloak:26.0.7"
export Z2JH_CHART_VERSION="4.0.0"
export SINGLEUSER_IMAGE="quay.io/jupyter/minimal-notebook:2026-08-10"
