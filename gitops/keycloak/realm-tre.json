{
  "realm": "tre",
  "enabled": true,
  "displayName": "KID Training TRE",
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [
    {
      "name": "alpha",
      "attributes": {
        "description": [
          "Members may use research project alpha"
        ]
      }
    },
    {
      "name": "beta",
      "attributes": {
        "description": [
          "Members may use research project beta"
        ]
      }
    },
    {
      "name": "tre-admins",
      "attributes": {
        "description": [
          "JupyterHub administrators"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "jupyterhub",
      "name": "JupyterHub",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "secret": "jupyterhub-demo-secret",
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
